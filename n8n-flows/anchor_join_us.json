      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst body = raw.body ?? raw;\nconst a = body.survey_answers ?? body;\nconst m = body.metadata ?? {};\nconst submitted = m.submittedAt\n  ? new Date(m.submittedAt).toLocaleString('es-MX', { timeZone: 'America/Monterrey' })\n  : '—';\nconst esc = (s) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\n// Soporta slider (valor string) y multiselect (array)\nconst distancia = Array.isArray(a.distancia) ? a.distancia.join(', ') : (a.distancia || '—');\n\nreturn [{ json: {\n  type: body.type || 'waitlist',\n  tracking_id: a.tracking_id || m.tracking_id || '—',\n  nombre: esc(a.nombre || a.name || '—'),\n  email: esc(a.email || a.correo || '—'),\n  telefono: esc(a.telefono || a.phone || m.phoneNumber || '—'),\n  distancia: esc(distancia),\n  descripcion: esc(a.descripcion || a.why || '—'),\n  instagram: esc(a.instagram || '—'),\n  source: m.source || 'join_us_page',\n  submitted_at_local: submitted,\n  submitted_at_utc: m.submittedAt || '—',\n  raw: body\n}}];"
      },
