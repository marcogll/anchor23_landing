      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst body = raw.body ?? raw;\nconst a = body.survey_answers ?? body;\nconst m = body.metadata ?? {};\nconst submitted = m.submittedAt\n  ? new Date(m.submittedAt).toLocaleString('es-MX', { timeZone: 'America/Monterrey' })\n  : '—';\nconst esc = (s) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\n// Soporta multiselect para modalidad\nconst modalidad = Array.isArray(a.modalidad || a.space_type)\n  ? (a.modalidad || a.space_type).join(', ')\n  : esc(a.modalidad || a.space_type || '—');\n\nreturn [{ json: {\n  type: body.type || 'space_inquiry',\n  tracking_id: a.tracking_id || m.tracking_id || '—',\n  nombre: esc(a.nombre || a.name || '—'),\n  email: esc(a.email || a.correo || '—'),\n  telefono: esc(a.telefono || a.phone || m.phoneNumber || '—'),\n  modalidad,\n  mensaje: esc(a.mensaje || '—'),\n  source: m.source || 'espacios_page',\n  submitted_at_local: submitted,\n  submitted_at_utc: m.submittedAt || '—',\n  raw: body\n}}];"
      },
      "type": "n8n-nodes-base.code",
