D9BEB3;padding-bottom:2px;margin:9px 0 5px\">1 · Información</div>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n<td style=\"vertical-align:top;padding:0 7px 5px 0;width:38%\"><div style=\"font-family:Inter,Arial,sans-serif;font-weight:700;font-size:5.8pt;letter-spacing:.13em;text-transform:uppercase;color:#B8A89A;margin-bottom:1px\">Nombre</div><div style=\"font-family:Inter,Arial,sans-serif;font-weight:400;font-size:7.8pt;color:#3F362E;border-bottom:.5px solid #EFE7DE;padding-bottom:2px;min-height:13px\">${esc(d.nombre)}</div></td>\n<td style=\"vertical-align:top;padding:0 7px 5px 0;width:32%\"><div style=\"font-family:Inter,Arial,sans-serif;font-weight:700;font-size:5.8pt;letter-spacing:.13em;text-transform:uppercase;color:#B8A89A;margin-bottom:1px\">Tipo</div><div style=\"font-family:Inter,Arial,sans-serif;font-weight:400;font-size:7.8pt;color:#3F362E;border-bottom:.5px solid #EFE7DE;padding-bottom:2px;min-height:13px\">${esc(d.tipo)}</div></td>\n<td style=\"vertical-align:top;padding:0 7px 5px 0;width:30%\"><div style=\"font-family:Inter,Arial,sans-serif;font-weight:700;font-size:5.8pt;letter-spacing:.13em;text-transform:uppercase;color:#B8A89A;margin-bottom:1px\">Seguidores</div><div style=\"font-family:Inter,Arial,sans-serif;font-weight:400;font-size:7.8pt;color:#3F362E;border-bottom:.5px solid #EFE7DE;padding-bottom:2px;min-height:13px\">${esc(d.seguidores||'—')}</div></td>\n</tr><tr>\n<td><div style=\"font-family:Inter,Arial,sans-serif;font-weight:700;font-size:5.8pt;letter-spacing:.13em;text-transform:uppercase;color:#B8A89A;margin-bottom:1px\">Email</div><div style=\"font-family:Inter,Arial,sans-serif;font-weight:400;font-size:7.8pt;color:#3F362E;border-bottom:.5px solid #EFE7DE;padding-bottom:2px;min-height:13px\">${esc(d.email)}</div></td>\n<td colspan=\"2\"><div style=\"font-family:Inter,Arial,sans-serif;font-weight:700;font-size:5.8pt;letter-spacing:.13em;text-transform:uppercase;color:#B8A89A;margin-bottom:1px\">Instagram</div><div