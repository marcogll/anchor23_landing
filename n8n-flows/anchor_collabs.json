        "jsCode": "const raw = $input.first().json || {};\nconst body = raw.body ?? raw;\nconst a = body.survey_answers ?? body;\nconst m = body.metadata ?? {};\nconst submitted = m.submittedAt\n  ? new Date(m.submittedAt).toLocaleString('es-MX', { timeZone: 'America/Monterrey' })\n  : '—';\nconst esc = (s) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\n// Soporta multiselect (array) para tipo\nconst tipo = Array.isArray(a.tipo || a.collab_type) \n  ? (a.tipo || a.collab_type).join(', ') \n  : esc(a.tipo || a.collab_type || '—');\n\nreturn [{ json: {\n  type: body.type || 'collab_inquiry',\n  tracking_id: a.tracking_id || m.tracking_id || '—',\n  nombre: esc(a.nombre || a.name || '—'),\n  email: esc(a.email || a.correo || '—'),\n  instagram: esc(a.instagram || '—'),\n  tipo,\n  seguidores: esc(a.seguidores || a.followers || '—'),\n  mensaje: esc(a.mensaje || a.propuesta || '—'),\n  source: m.source || 'collabs_page',\n  submitted_at_local: submitted,\n  submitted_at_utc: m.submittedAt || '—',\n  raw: body\n}}];"
