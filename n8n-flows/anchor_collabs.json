v>\n<div style=\"font-family:Inter,Arial,sans-serif;font-size:5.5pt;color:#B8A89A;letter-spacing:.06em;text-align:right\">${esc(d.submitted_at_utc)}</div>\n</div>\n\n</div></body></html>`;\n\nconst html_internal_bw = bw(html_internal);\n\nreturn [{ json: {\n  _from_email: 'ANCHOR:23 <collabs@anchor23.mx>',\n  ...d,\n  email_to: d.email,\n  admin_to: 'collabs@anchor23.mx',\n  email_subject: `Propuesta recibida · ANCHOR:23 · ${d.nombre}`,\n  admin_subject: `🤝 Nueva colaboración · ${d.nombre}`,\n  html_email,\n  html_admin,\n  html_internal,\n  html_external: html_email,\n  html_internal,\n  html_external_bw: bw(html_email),\n  html_internal_bw,\n  filename_external: `collab_${slug(d.nombre)}_ext.html`,\n  filename_internal: `collab_${slug(d.nombre)}_int.html`,\n  filename_external_bw: `collab_${slug(d.nombre)}_ext_bw.html`,\n  filename_internal_bw: `collab_${slug(d.nombre)}_int_bw.html`,\n}}];\n"
